---
import SectionHeader from './SectionHeader.astro';
import { services } from '../data/services';
---
<section class="section" id="servicios" aria-labelledby="services-title">
  <div class="container">
    <SectionHeader label="03 / Servicios" title="¿En qué puedo ayudarte?" id="services-title" description="Para construir algo nuevo o hacer que lo que ya existe funcione mejor." />
    <div class="services-list">{services.map((service, index) => <article class="service">
      <span class="service-number" aria-hidden="true">0{index + 1}</span>
      <div><h3>{service.title}</h3><p>{service.description}</p></div>
      <a href="#contacto" aria-label={`${service.detail}: consultar sobre ${service.title.toLowerCase()}`}><span>{service.detail}</span><span class="arrow" aria-hidden="true">↗</span></a>
    </article>)}</div>
  </div>
</section>
<style>
  .service { display: grid; grid-template-columns: 2rem 1fr 15rem; gap: var(--space-5); border-top: 1px solid var(--color-border); padding-block: var(--space-6); align-items: center; }
  .service:last-child { border-bottom: 1px solid var(--color-border); }
  .service-number { align-self: start; font: 400 0.75rem/1.5 var(--font-mono); color: var(--color-muted); padding-top: 0.2rem; }
  h3 { font-size: 1.25rem; font-weight: 600; }
  p { font-size: 0.86rem; margin-top: var(--space-3); color: var(--color-muted); max-width: 38rem; }
  a { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); font-size: 0.7rem; text-decoration: none; padding: var(--space-3) 0 var(--space-3) var(--space-3); }
  a .arrow { font-size: 1.4rem; color: var(--color-primary); }
  a:hover { color: var(--color-primary); }
  @media (max-width: 880px) { .service { grid-template-columns: 1.3rem 1fr; } a { grid-column: 2; justify-content: start; padding: 0; min-height: 44px; } }
</style>
