---
import Brand from './Brand.astro';
import { profile } from '../../portfolio.config.mjs';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand"><Brand /></div>
      <p>{profile.name}<span>{profile.role}</span></p>
      <nav aria-label="Enlaces del pie de página">
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (nueva pestaña)</span></a>
        {profile.linkedin && <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (nueva pestaña)</span></a>}
        {profile.email && <a href={`mailto:${profile.email}`}>Email</a>}
        <a href="/#contenido">Volver arriba ↑</a>
      </nav>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} Diego Rangel</span><span>Hecho con Astro · <a href="https://github.com/ArTiCCaLt/personal-portfolio" target="_blank" rel="noopener noreferrer">Código fuente<span class="sr-only"> (nueva pestaña)</span></a></span></div>
  </div>
</footer>
<style>
  .site-footer { padding-block: var(--space-7) var(--space-5); }
  .footer-main { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-6); }
  .footer-brand > span { font-size: 1.12rem; font-weight: 800; letter-spacing: 0.09em; }
  .footer-brand > small { display: block; font-size: 0.62rem; color: var(--color-muted); }
  .footer-main p { font-size: 0.78rem; font-weight: 650; }
  .footer-main p > span { display: block; font-size: 0.66rem; font-weight: 400; color: var(--color-muted); margin-top: var(--space-1); }
  nav { display: flex; flex-wrap: wrap; gap: var(--space-5); }
  nav a { min-height: 44px; display: flex; align-items: center; font-size: 0.72rem; text-decoration: none; }
  nav a:hover { color: var(--color-primary); }
  .footer-bottom { margin-top: var(--space-6); padding-top: var(--space-5); display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); border-top: 1px solid var(--color-border); color: var(--color-muted); font-size: 0.65rem; }
</style>
